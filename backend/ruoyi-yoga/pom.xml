<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <parent>
        <artifactId>ruoyi</artifactId>
        <groupId>com.ruoyi</groupId>
        <version>3.9.2</version>
    </parent>
    <modelVersion>4.0.0</modelVersion>

    <artifactId>ruoyi-yoga</artifactId>

    <description>
        瑜伽业务模块：业务包名 com.techplant.yoga，ORM 使用 MyBatis-Plus
        （详细设计 docs/详细设计/详细设计.md §1.1.1、§3.2 已确认口径）
    </description>

    <dependencies>

        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <scope>provided</scope>
        </dependency>

        <!-- 通用工具（SecurityUtils / StringUtils 等） -->
        <dependency>
            <groupId>com.ruoyi</groupId>
            <artifactId>ruoyi-common</artifactId>
        </dependency>

        <!-- SpringBoot Web（控制器注解、参数校验） -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>

        <!-- MyBatis-Plus：BaseMapper / IdType.ASSIGN_ID / @TableLogic / MetaObjectHandler -->
        <dependency>
            <groupId>com.baomidou</groupId>
            <artifactId>mybatis-plus-boot-starter</artifactId>
        </dependency>

        <!-- 接口文档注解（@Api/@ApiOperation/@ApiModelProperty）：springfox 的注解在 io.swagger 包下，
             版本与 ruoyi-admin 显式引入的 swagger-models 1.6.2 对齐 -->
        <dependency>
            <groupId>io.swagger</groupId>
            <artifactId>swagger-annotations</artifactId>
            <version>1.6.2</version>
        </dependency>

        <!-- 集成测试：Spring 测试上下文与 JUnit 5，不引入模拟对象库 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
            <exclusions>
                <exclusion>
                    <groupId>org.mockito</groupId>
                    <artifactId>mockito-core</artifactId>
                </exclusion>
                <exclusion>
                    <groupId>org.mockito</groupId>
                    <artifactId>mockito-junit-jupiter</artifactId>
                </exclusion>
            </exclusions>
        </dependency>

        <!-- 集成测试：隔离的真实 MySQL 容器，表结构与容器由测试自行准备和回收 -->
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>mysql</artifactId>
            <scope>test</scope>
        </dependency>

        <!-- 集成测试直连容器库所需驱动：生产运行时由 ruoyi-admin 提供，本模块测试自己带一份 -->
        <dependency>
            <groupId>mysql</groupId>
            <artifactId>mysql-connector-java</artifactId>
            <scope>test</scope>
        </dependency>

        <!-- 仅测试范围：集成测试跑真实的 MyBatisConfig（SqlSessionFactory 由它在 ruoyi-framework 里构建），
             业务代码本身不依赖框架模块 -->
        <dependency>
            <groupId>com.ruoyi</groupId>
            <artifactId>ruoyi-framework</artifactId>
            <scope>test</scope>
        </dependency>

    </dependencies>

    <build>
        <testResources>
            <!-- 集成测试自己的资源 -->
            <testResource>
                <directory>src/test/resources</directory>
            </testResource>
            <!-- 集成测试使用运行环境的配置来源：这两份文件由 Maven 复制，测试侧不维护副本 -->
            <testResource>
                <directory>../ruoyi-admin/src/main/resources</directory>
                <includes>
                    <include>application.yml</include>
                    <include>mybatis/mybatis-config.xml</include>
                </includes>
            </testResource>
        </testResources>
        <plugins>
            <!-- 使用支持 JUnit 5 的执行器运行集成测试 -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>2.22.2</version>
            </plugin>
        </plugins>
    </build>

</project>
